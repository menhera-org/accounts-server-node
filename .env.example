PORT=3000
SECRET="please generate random string"
ALIASES_PATH=/etc/aliases
ADMIN_GROUP=sudo
INTERNAL_GROUP=org

# The user to add to any mailing lists
ALL_LISTS_USER=root

OIDC_ISSUER=https://manage.menhera.org/oidc/
JWKS_PATH=jwks.json
CLIENTS_PATH=clients.json
COOKIES_KEYS_PATH=cookies-keys.json
USER_EMAIL_DOMAIN=menhera.org

SERVER_USER=nobody
PAM_SERVICE_NAME=login

MONGODB_URL=mongodb://127.0.0.1:27017/db

# Login proof-of-work: size in bits of the balanced semiprime the browser must factor (even numbers).
# Each failed login attempt in a session raises the size by LOGIN_QUIZ_STEP_BITS up to LOGIN_QUIZ_MAX_BITS.
LOGIN_QUIZ_BITS=240
LOGIN_QUIZ_STEP_BITS=16
LOGIN_QUIZ_MAX_BITS=288
# Failures are also counted per client address (IPv4 /32, IPv6 /64); a bucket's count expires this long after its last failure.
LOGIN_FAILURE_WINDOW_SECONDS=3600
